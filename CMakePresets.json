{
  "version": 5,
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux x86-64 with vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/AtlasNet-SourceBridge/AtlasNet/vcpkg-triplets/clang-toolchain.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/AtlasNet-SourceBridge/AtlasNet/vcpkg-triplets"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "targets": ["atlasnet_gmod"]
    }
  ]
}
